# ==============================================================================
# Sologix Energy — Production Environment Variables (.env)
# ==============================================================================

# Timezone (Must always be Asia/Kolkata)
TZ=Asia/Kolkata

# Domain Configuration for Automated SSL/TLS via Caddy
DOMAIN=attendance.yourcompany.com
ACME_EMAIL=admin@yourcompany.com

# Database Credentials (Private internal network only)
POSTGRES_DB=sologix_db
POSTGRES_USER=sologix_user
POSTGRES_PASSWORD=your_strong_postgres_password_here

# JWT Authentication Secret
JWT_SECRET=generate_random_64_character_hex_string_here

# Allowed CORS Origins (Include your production domain and mobile origins)
ALLOWED_ORIGINS=https://attendance.yourcompany.com

# Bootstrap First Admin (Only used once on clean installation)
SYSTEM_ADMIN=admin@yourcompany.com
SYSTEM_ADMIN_PASSWORD=AdminSecurePass2026!

# Automatic geofence check-in/out trigger (default false; manual buttons are source of truth)
AUTO_GEOFENCE_ATTENDANCE=false

# Google Cloud Storage Automated Backup Bucket
GCS_BACKUP_BUCKET=your-gcs-backup-bucket-name

# SMTP Notifications (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
