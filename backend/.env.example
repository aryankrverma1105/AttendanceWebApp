DATABASE_URL=""
SMTP_HOST="mail.example.com"
SMTP_PORT=465
SMTP_USER="noreply@example.com"
SMTP_PASS="XYZ"
SMTP_SECURE=true
JWT_SECRET="replace-with-a-long-random-string-never-reuse-this-example-value"
BASE_URL="http://localhost:3000"

# Optional: auto-creates the first ADMIN account on login with this email+password.
# Leave both unset once a real admin account exists.
SYSTEM_ADMIN=""
SYSTEM_ADMIN_PASSWORD=""

# Explicit opt-in for local-dev-only conveniences (x-user-role header auth, permissive CORS).
# Never set this in a real deployment.
ALLOW_DEV_MODE=false