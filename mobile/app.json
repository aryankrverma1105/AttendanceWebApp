{
  "expo": {
    "name": "Sologix Energy",
    "slug": "sologix-energy",
    "version": "1.0.0",
    "description": "Sologix Energy - Powering Attendance with the Sun",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBase": "http://34.180.17.0:8088/api",
      "cartoApiKey": "cb1_4e5f_1_4f7d31c7b00835a4b92885e3",
      "mapTileUrl": "https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=cb1_4e5f_1_4f7d31c7b00835a4b92885e3",
      "eas": {
        "projectId": "757a8e36-b141-4854-97af-ad3c08369396"
      }
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FFFBF0"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sologix Energy needs your location to record attendance during your shift.",
          "locationAlwaysPermission": "Sologix Energy needs always-on location to record attendance even when the app is in the background.",
          "locationWhenInUsePermission": "Sologix Energy needs location access to show your proximity to assigned solar sites.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-sqlite"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sologix.energy"
    },
    "android": {
      "package": "com.sologix.energy",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBF0"
      }
    }
  }
}
